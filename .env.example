# SplitSmart — environment variables
#
# Copy this file to ".env.local" and fill in your own values. NEVER commit real keys.
#
#   cp .env.example .env.local
#
# You don't need any of these for Hour 2 (the basic app). You'll add them as you go:

# Public browser configuration. These values are safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Gemini configuration. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
